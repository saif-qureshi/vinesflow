# Reference copy. In production the instance writes this file with your real domain
# (see infra/terraform/templates/user_data.sh.tftpl). Caddy auto-provisions Let's Encrypt TLS.
{$API_DOMAIN:api.localhost} {
    encode gzip zstd

    log {
        output stdout
        format json
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Keep /api in the upstream URI; FastAPI mounts its routes at /api/v1.
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Public dependency-aware health endpoint for Route53/CloudWatch monitoring.
    handle /healthz {
        rewrite * /ready
        reverse_proxy backend:8000
    }

    respond "Not found" 404
}
