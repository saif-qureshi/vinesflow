# Reference copy. In production the instance writes this file with your real domain
# (see infra/terraform/templates/user_data.sh.tftpl). Caddy auto-provisions Let's Encrypt TLS.
{$APP_DOMAIN:app.localhost} {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    # Keep /api in the upstream URI; FastAPI mounts its routes at /api/v1.
    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:3000
    }
}
