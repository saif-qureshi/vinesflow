# In production this file is generated by Terraform (SSM SecureString) and fetched at boot.
# This is a reference of the values the backend expects in prod.
ENVIRONMENT=production
DATABASE_URL=postgresql+psycopg://vineflow:CHANGE_ME@your-rds-endpoint:5432/vineflow
JWT_SECRET=CHANGE_ME_long_random
FBR_BASE_URL=https://gw.fbr.gov.pk
FBR_ENCRYPTION_KEY=CHANGE_ME_fernet_key
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
BACKEND_CORS_ORIGINS=https://app.yourdomain.com,https://admin.yourdomain.com
GOTENBERG_URL=http://gotenberg:3000
STORAGE_BACKEND=s3
S3_BUCKET=vinesflow-prod-media-000000000000
S3_REGION=ap-south-1
S3_PUBLIC_URL=https://media.yourdomain.com
MEDIA_KEY_PREFIX=
MAX_UPLOAD_MB=10
