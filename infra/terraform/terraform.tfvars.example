# Copy to terraform.tfvars and fill in. Only domain_name is required.

domain_name = "yourdomain.com"

# S3 names use the public brand spelling independently of internal resource names.
# bucket_prefix = "vinesflow"

# If your domain is in Route53, set the hosted zone id for full DNS + TLS automation.
# Leave empty to manage DNS at your registrar (records are printed as outputs; you'll
# also need to validate the CloudFront ACM cert manually).
route53_zone_id = "" # e.g. "Z0123456789ABCDEFGHIJ"

# With manual DNS, the first apply prints acm_validation_record. Add it, wait for
# ACM to become ISSUED, then set this true and apply again.
activate_media_domain = false

# Production defaults:
# instance_type     = "t4g.medium"
# db_instance_class = "db.t4g.micro"
# Pin the current AL2023 ARM64 AMI to prevent surprise replacement on a later apply:
# ami_id = "ami-0123456789abcdef0"

# SSH is closed by default (use SSM Session Manager). To enable Terraform-managed SSH:
# ssh_ingress_cidr = "203.0.113.4/32"
# ssh_public_key   = "ssh-ed25519 AAAA... workstation"
# Alternatively, use an existing EC2 key pair:
# key_pair_name = "my-keypair"

# Get alerted when the box/DB is unhealthy or spend passes the budget:
# alarm_email = "ops@yourdomain.com"
# monthly_budget_usd = 50

# Enable GitHub Actions CI/CD (OIDC, no static keys). Set to owner/repo:
# github_repo = "saif-qureshi/vinesflow"
# If your GitHub organization customizes OIDC subjects with immutable IDs:
# github_oidc_subject = "repo:owner@123/repository@456:ref:refs/heads/main"
# If your account already has a GitHub OIDC provider, pass its ARN to reuse it:
# github_oidc_provider_arn = "arn:aws:iam::730335575446:oidc-provider/token.actions.githubusercontent.com"

# Optional: create a long-lived IAM key scoped to local/* media objects.
# Keep disabled unless local development actively needs the production S3 bucket.
# enable_local_dev_credentials = true
