#!/bin/bash
set -euxo pipefail

# ---------------------------------------------------------------- swap (Gotenberg safety net)
%{ if swap_gb > 0 ~}
if [ ! -f /swapfile ]; then
  dd if=/dev/zero of=/swapfile bs=1M count=${swap_gb * 1024}
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo '/swapfile none swap sw 0 0' >> /etc/fstab
  sysctl -w vm.swappiness=10
fi
%{ endif ~}

# ---------------------------------------------------------------- docker + compose
dnf update -y
dnf install -y docker amazon-cloudwatch-agent
systemctl enable --now docker
mkdir -p /usr/libexec/docker/cli-plugins
curl -fsSL "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-aarch64" \
  -o /usr/libexec/docker/cli-plugins/docker-compose
chmod +x /usr/libexec/docker/cli-plugins/docker-compose

mkdir -p /opt/vineflow
cd /opt/vineflow

# ---------------------------------------------------------------- config files
cat > /opt/vineflow/docker-compose.yml <<'COMPOSE_EOF'
${compose_content}
COMPOSE_EOF

cat > /opt/vineflow/Caddyfile <<'CADDY_EOF'
${caddy_content}
CADDY_EOF

cat > /opt/vineflow/deploy.sh <<'DEPLOY_SCRIPT_EOF'
${deploy_script}
DEPLOY_SCRIPT_EOF
chmod 755 /opt/vineflow/deploy.sh

cat > /opt/vineflow/deploy.env <<DEPLOY_EOF
ECR_BACKEND=${ecr_backend}
IMAGE_TAG=not-deployed
API_DOMAIN=${api_domain}
AWS_REGION=${region}
SSM_ENV_PARAM=${ssm_env_param}
CLOUDWATCH_LOG_GROUP=${log_group_name}
DEPLOY_EOF

# backend secrets/config from SSM
aws ssm get-parameter --with-decryption --region ${region} \
  --name "${ssm_env_param}" --query 'Parameter.Value' --output text > /opt/vineflow/backend.env
chmod 600 /opt/vineflow/backend.env

# ---------------------------------------------------------------- ECR login (runs at boot and before every deploy)
cat > /opt/vineflow/ecr-login.sh <<'LOGIN_EOF'
#!/bin/bash
set -e
ACCOUNT=$(aws sts get-caller-identity --query Account --output text)
aws ecr get-login-password --region ${region} | \
  docker login --username AWS --password-stdin "$ACCOUNT.dkr.ecr.${region}.amazonaws.com"
LOGIN_EOF
chmod +x /opt/vineflow/ecr-login.sh
/opt/vineflow/ecr-login.sh || true

# ---------------------------------------------------------------- container IMDS isolation
# Only the backend/worker/migration network can reach instance-role credentials.
cat > /opt/vineflow/metadata-firewall.sh <<'FIREWALL_EOF'
#!/bin/bash
set -euo pipefail
iptables -C DOCKER-USER -s 172.28.0.0/24 -d 169.254.169.254/32 -j ACCEPT 2>/dev/null || \
  iptables -I DOCKER-USER 1 -s 172.28.0.0/24 -d 169.254.169.254/32 -j ACCEPT
iptables -C DOCKER-USER -d 169.254.169.254/32 -j DROP 2>/dev/null || \
  iptables -A DOCKER-USER -d 169.254.169.254/32 -j DROP
FIREWALL_EOF
chmod 755 /opt/vineflow/metadata-firewall.sh

cat > /etc/systemd/system/vineflow-metadata-firewall.service <<'FIREWALL_UNIT_EOF'
[Unit]
Description=Restrict container access to EC2 instance metadata
Requires=docker.service
After=docker.service
Before=vineflow.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/vineflow/metadata-firewall.sh

[Install]
WantedBy=multi-user.target
FIREWALL_UNIT_EOF

# ---------------------------------------------------------------- host metrics
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'CWAGENT_EOF'
{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "Vineflow",
    "append_dimensions": {
      "InstanceId": "$${aws:InstanceId}"
    },
    "aggregation_dimensions": [["InstanceId"]],
    "metrics_collected": {
      "mem": {
        "measurement": ["mem_used_percent"],
        "metrics_collection_interval": 60
      },
      "disk": {
        "measurement": ["used_percent"],
        "metrics_collection_interval": 60,
        "resources": ["/"],
        "drop_device": true
      },
      "swap": {
        "measurement": ["swap_used_percent"],
        "metrics_collection_interval": 60
      }
    }
  }
}
CWAGENT_EOF
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
systemctl enable amazon-cloudwatch-agent

# ---------------------------------------------------------------- systemd unit (boot + auto-recovery)
cat > /etc/systemd/system/vineflow.service <<'UNIT_EOF'
[Unit]
Description=Vineflow stack
Requires=docker.service
Requires=vineflow-metadata-firewall.service
After=docker.service vineflow-metadata-firewall.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/vineflow
ExecStartPre=/opt/vineflow/ecr-login.sh
ExecStartPre=/bin/bash -c '/usr/bin/aws ssm get-parameter --with-decryption --region ${region} --name "${ssm_env_param}" --query "Parameter.Value" --output text > /opt/vineflow/backend.env.next && chmod 600 /opt/vineflow/backend.env.next && mv /opt/vineflow/backend.env.next /opt/vineflow/backend.env'
ExecStart=/usr/bin/docker compose --env-file deploy.env pull
ExecStartPost=/usr/bin/docker compose --env-file deploy.env up -d --remove-orphans
ExecStop=/usr/bin/docker compose --env-file deploy.env down
Restart=on-failure
RestartSec=30
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
UNIT_EOF

systemctl daemon-reload
# ECR is empty on the first provision. Enable the unit for future reboots; the
# first CI/manual deploy starts the stack after immutable images have been pushed.
systemctl enable vineflow.service

# ---------------------------------------------------------------- nightly logical DB dump -> S3 (belt & suspenders; RDS also has automated backups)
cat > /opt/vineflow/backup.sh <<'BACKUP_EOF'
#!/bin/bash
set -euo pipefail
PGPASS=$(grep '^DATABASE_URL=' /opt/vineflow/backend.env | sed -E 's#.*://[^:]+:([^@]+)@.*#\1#')
STAMP=$(date +%Y%m%d-%H%M%S)
FILE=/tmp/${db_name}-$STAMP.sql.gz
trap 'rm -f "$FILE"' EXIT
docker run --rm -e PGPASSWORD="$PGPASS" postgres:16-alpine \
  pg_dump -h ${db_host} -U ${db_user} -d ${db_name} | gzip > "$FILE"
aws s3 cp "$FILE" "s3://${backups_bucket}/db/${db_name}-$STAMP.sql.gz" --region ${region}
aws cloudwatch put-metric-data --region ${region} --namespace Vineflow \
  --metric-name BackupSuccess --dimensions Project=${project_name} --value 1 --unit Count
BACKUP_EOF
chmod +x /opt/vineflow/backup.sh

cat > /etc/systemd/system/vineflow-backup.service <<'BSVC_EOF'
[Unit]
Description=Vineflow nightly DB dump
[Service]
Type=oneshot
UMask=0077
ExecStart=/opt/vineflow/backup.sh
BSVC_EOF

cat > /etc/systemd/system/vineflow-backup.timer <<'BTIMER_EOF'
[Unit]
Description=Run Vineflow DB dump nightly
[Timer]
OnCalendar=*-*-* 20:00:00 UTC
Persistent=true
[Install]
WantedBy=timers.target
BTIMER_EOF

systemctl daemon-reload
systemctl enable vineflow-metadata-firewall.service
systemctl enable --now vineflow-backup.timer
