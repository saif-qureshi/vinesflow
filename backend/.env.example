# Copy to .env and adjust
DATABASE_URL=postgresql+psycopg://vineflow:vineflow@localhost:5433/vineflow

# Auth
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated origins for the Next.js frontend)
BACKEND_CORS_ORIGINS=http://localhost:3005

# Environment
ENVIRONMENT=development

# Background worker (Celery). Dev runs tasks inline; prod uses SQS.
CELERY_TASK_ALWAYS_EAGER=true
